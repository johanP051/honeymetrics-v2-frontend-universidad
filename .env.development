# ==========================================================
# HONEYMETRICS V2 FRONTEND - DEVELOPMENT ENVIRONMENT (VITE DEV)
# ==========================================================
# Se activa automáticamente al ejecutar: npm run dev

# 1. Conexión a la API Backend
# Para pruebas con el Home Server vía Cloudflare Tunnel:
VITE_API_URL="https://api-honey-v2-homeserver.johan-d3v.site/api/v1"
# Para pruebas en desarrollo local puro (descomentar si backend corre en esta máquina):
# VITE_API_URL="http://localhost:8001/api/v1"

# 2. Modo de datos ("live" para consultar backend, "mock" para datos simulados offline)
VITE_DATA_MODE="live"

# 3. Identificador de entorno para telemetría visual / logs
VITE_APP_ENV="development"

