# ==================================================
# HONEYMETRICS V2 UNIVERSIDAD - FRONTEND ENVIRONMENT
# ==================================================

# URL Base de la API Backend universitaria
# En desarrollo apunta al puerto 8001 de FastAPI:
VITE_API_URL="http://localhost:8001/api/v1"

# Modo de datos ("live" para consultar backend, "mock" para datos simulados offline)
VITE_DATA_MODE="live"

# Si se usa Cloudflare Tunnel (ej. https://api.tudominio.com), descomentar y ajustar:
# VITE_API_URL="https://api.tudominio.com/api/v1"
