# ==========================================================
# HONEYMETRICS V2 UNIVERSIDAD - FRONTEND ENVIRONMENT TEMPLATE
# ==========================================================

# 1. URL Base de la API Backend universitaria
# Opción A: Probar directo contra el Home Server vía Cloudflare Tunnel (no requiere backend local)
#VITE_API_URL="https://api-honey-v2-homeserver.johan-d3v.site/api/v1"
VITE_API_URL="localhost:8001/api/v1"


# Opción B: Si levantas el Backend en tu propia máquina con Docker (puerto 8001):
# VITE_API_URL="http://localhost:8001/api/v1"

# 2. Modo de datos ("live" para consultar backend, "mock" para datos simulados offline)
VITE_DATA_MODE="live"

# 3. Identificador de entorno
VITE_APP_ENV="development"

