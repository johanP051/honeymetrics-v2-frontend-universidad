# ==========================================================
# HONEYMETRICS V2 FRONTEND - PRODUCTION ENVIRONMENT (PAGES / NGINX)
# ==========================================================
# Se activa automáticamente al compilar con: npm run build (Cloudflare Pages / Docker Prod)

# 1. Conexión a la API Backend Remota (Home Server Staging vía Túnel Cloudflare)
VITE_API_URL="https://api-honey-v2-homeserver.johan-d3v.site/api/v1"

# 2. Modo de datos ("live" para consultar backend, "mock" como fallback de resiliencia)
VITE_DATA_MODE="live"

# 3. Identificador de entorno para telemetría visual / logs
VITE_APP_ENV="production"
