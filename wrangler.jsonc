{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honeymetrics-v2-frontend",
  "compatibility_date": "2026-10-19",
  "routes": [
    {
      "pattern": "honey-v2.johan-d3v.site",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
